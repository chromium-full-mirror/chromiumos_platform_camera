group("all") {
  deps = [
    ":libcam_algo",
    ":libcamhal",
    ":install_intel_ipu6_so",
  ]

  if (use.ipu6se) {
    deps += [
      ":libcam_algo_vendor_gpu",
    ]
  }

  if (use.ipu6epadln) {
    deps += [
      ":libcam_algo_vendor_gpu",
    ]
  }

  if (use.ipu6epmtl) {
    deps += [
      ":libcam_algo_vendor_gpu",
    ]
  }
}

config("default_compiler_flags") {
  # HACK: For some reason, `cflags` doesn't get applied to all C & C++ builds.
  # Applying the same flags through `cflags_c` and `cflags_cc` does work,
  # however.
  default_cflags = [
    # This codebase has many `TRACE` macros that are `#define`d as nothing in
    # some build configurations. This causes false-positives for
    # -Wno-unused-but-set-variable.
    "-Wno-unused-but-set-variable",
    "-Wno-deprecated-enum-enum-conversion",
    # Similarly, this codebase makes use of VLAs in quite a few places. These
    # are generally discouraged, but functionally speaking, won't go away.
    "-Wno-vla-cxx-extension",
  ]
  cflags_c = default_cflags
  cflags_cc = default_cflags + [
    "-fvisibility=default",
  ]
}

